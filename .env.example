# --- Required ---
# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Postgres connection string (SQLAlchemy async via psycopg v3).
# In docker-compose, host is the service name `postgres`.
DATABASE_URL=postgresql+psycopg://cfo:cfo@postgres:5432/personal_cfo

# Redis connection string. In docker-compose, host is the service name `redis`.
REDIS_URL=redis://redis:6379/0

# 32+ character random secret. Generate: openssl rand -hex 32
JWT_SECRET_KEY=

# Fernet key (base64-encoded, 32 bytes). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Document the key-rotation runbook before changing.
VAULT_ENCRYPTION_KEY=

# SMTP credentials for the weekly digest
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Where the weekly digest is sent
DIGEST_RECIPIENT=

# --- Optional ---
# JWT lifetime in minutes
JWT_EXPIRY_MINUTES=60

# Anthropic call timeout + SDK retry count for 429/5xx
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Anthropic model ids. Defaults preserve the app's current tiers; override to
# change models without editing code. "smart" = agent/intake reasoning,
# "fast" = the analyzer's classification-only routing call.
ANTHROPIC_MODEL_SMART=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# development | production. Gates /docs visibility and log format.
ENV=development

# LangGraph checkpoint backend
LANGGRAPH_CHECKPOINT_BACKEND=redis

# Override the canonical disclaimer (defaults to disclaimer.DISCLAIMER)
# WEALTH_DISCLAIMER_TEXT=

# Alert thresholds
ALERT_DRIFT_PCT_THRESHOLD=25
ALERT_INCOME_DROP_PCT_THRESHOLD=30

# --- Issue 4b: Free data integrations ---
# RentCast AVM for property value estimates (free tier: 50 calls/month).
# Sign up at https://app.rentcast.io/register — no credit card required.
# If absent, POST /vault/real-estate/refresh-values returns 503.
# RENTCAST_API_KEY=

# Alpha Vantage fallback for stock/ETF prices (free tier: 25 requests/day).
# https://www.alphavantage.co/support/#api-key — optional; yfinance is primary.
# ALPHA_VANTAGE_KEY=

# --- CORS (Issue 27) ---
# Comma-separated list of allowed origins for CORS. Add your production domain here.
# ALLOWED_ORIGINS=["https://yourdomain.com"]

# --- Monitoring (optional) ---
# Dead-man's-switch URL pinged every 5 min by the worker. If pings stop (app or
# VM down), the monitor alerts you. Create a free check at https://healthchecks.io
# and paste its ping URL. If unset, no ping is sent.
# HEALTHCHECK_PING_URL=https://hc-ping.com/your-uuid-here

# --- Phase 2 (Plaid; not yet wired) ---
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# Cloudflare Tunnel token — get from Zero Trust → Networks → Tunnels → your tunnel → Docker install command
CLOUDFLARE_TUNNEL_TOKEN=

# --- Postgres service config (used by docker-compose) ---
POSTGRES_USER=cfo
POSTGRES_PASSWORD=cfo
POSTGRES_DB=personal_cfo
