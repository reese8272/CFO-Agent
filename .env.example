# --- Required ---
# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Postgres connection string (SQLAlchemy async via psycopg v3).
# In docker-compose, host is the service name `postgres`.
DATABASE_URL=postgresql+psycopg://cfo:cfo@postgres:5432/personal_cfo

# Redis connection string. In docker-compose, host is the service name `redis`.
REDIS_URL=redis://redis:6379/0

# 32+ character random secret. Generate: openssl rand -hex 32
JWT_SECRET_KEY=

# Fernet key (base64-encoded, 32 bytes). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Document the key-rotation runbook before changing.
VAULT_ENCRYPTION_KEY=

# SMTP credentials for the weekly digest
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Where the weekly digest is sent
DIGEST_RECIPIENT=

# --- Optional ---
# JWT lifetime in minutes
JWT_EXPIRY_MINUTES=60

# Anthropic call timeout
LLM_TIMEOUT_SECONDS=120

# development | production. Gates /docs visibility and log format.
ENV=development

# LangGraph checkpoint backend
LANGGRAPH_CHECKPOINT_BACKEND=redis

# Override the canonical disclaimer (defaults to disclaimer.DISCLAIMER)
# WEALTH_DISCLAIMER_TEXT=

# Alert thresholds
ALERT_DRIFT_PCT_THRESHOLD=25
ALERT_INCOME_DROP_PCT_THRESHOLD=30

# --- Phase 2 (Plaid; not yet wired) ---
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# --- Postgres service config (used by docker-compose) ---
POSTGRES_USER=cfo
POSTGRES_PASSWORD=cfo
POSTGRES_DB=personal_cfo
